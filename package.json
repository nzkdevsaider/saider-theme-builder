{
  "name": "saider-theme-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin to install a primitive system and manage themes as variable collections.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "harness": "node scripts/build.mjs --harness",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "preact": "10.24.3"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.100.2",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
